# --- Service ---
PORT=3100
NODE_ENV=development

# Comma-separated API keys accepted from the main application (X-API-Key
# header). These resolve to the 'default' tenant — fine while one app uses
# the service; add API_CLIENTS when a second app integrates.
SERVICE_API_KEYS=dev-key-change-me

# Multi-tenant API clients (JSON). Each app gets its OWN key and webhook
# endpoint: a wallet created under slug 'acme' is invisible to every other
# key, and acme's deposit events sign with acme's webhookSecret and POST to
# acme's webhookUrl — never to another app's server.
# Onboarding a new app = add an entry here + restart. Ops action by design:
# a new tenant is a custody trust decision, not a self-serve signup.
# API_CLIENTS=[{"slug":"acme","name":"Acme Pay","apiKey":"<openssl rand -hex 24>","webhookUrl":"https://api.acme.example/webhooks/crypto","webhookSecret":"<openssl rand -hex 32>"}]
API_CLIENTS=

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitlily_crypto

# --- Tatum ---
TATUM_API_KEY=
TATUM_BASE_URL=https://api.tatum.io
# testnet | mainnet — controls which Tatum endpoints/networks are used
TATUM_NETWORK=testnet
# If true, withdrawals are signed via a self-hosted Tatum KMS daemon (production required).
# KMS is a CLI daemon, not a REST service — enrollment is operator-run
# `tatum-kms generatemanagedwallet {chain}` on the KMS host, then registered
# here via POST /api/v1/admin/custody. See docs/KMS_SETUP.md.
# With TATUM_USE_KMS=false AND TATUM_NETWORK=mainnet the service refuses to boot.
TATUM_USE_KMS=false
# Shared secret embedded in the KMS daemon's --externalUrl path:
#   --externalUrl={base}/api/v1/kms/verify/{KMS_VERIFY_TOKEN}
# KMS concatenates {externalUrl}/{txId} — the token MUST be a path segment.
KMS_VERIFY_TOKEN=
# Daemon-side (consumed by the `kms` compose service, not the API):
# unlocks the local wallet store the daemon signs with.
TATUM_KMS_PASSWORD=
# Host path the daemon's wallet file is bind-mounted from — the custody
# keys live here, NOT in the container. Back this file up; losing it with
# no other backup means losing custody.
KMS_WALLET_FILE=

# Solana JSON-RPC for shared-address deposit scanning + tx detail.
# Tatum has NO SOL address-history surface — SOL detection is canonical-RPC.
# The public cluster endpoints below are devnet-grade; production should
# point at a dedicated RPC (Helius/QuickNode/self-hosted) for rate limits
# and reliability. Default follows TATUM_NETWORK (devnet or mainnet-beta).
# SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Address-history indexers (txid attribution for the poller) ---
# The delta poller attributes real txids via these sources; when a source
# is unreachable/empty the delta stays pending+unattributed — it never
# falls back to crediting a synthetic txid (ledger-enforced invariant).
# TRONGRID_URL  : TronGrid for native TRX + TRC20 history (Tatum has no
#                 TRON address enumeration). Shasta on testnet.
# HISTORY_*_URL : any etherscan-compat explorer (Blockscout legacy /api,
#                 polygonscan, etherscan, routescan). *_API_KEY optional —
#                 Amoy has NO usable keyless indexer, set a polygonscan key.
# TRONGRID_URL=https://api.shasta.trongrid.io
# HISTORY_ETH_URL=https://eth-sepolia.blockscout.com/api
# HISTORY_ETH_API_KEY=
# HISTORY_POLYGON_URL=https://api-amoy.polygonscan.com/api
# HISTORY_POLYGON_API_KEY=

# Comma-separated admin keys (X-Admin-Key header) for custody enrollment and
# withdrawal approval. REQUIRED in production — admin endpoints refuse all
# callers when unset and TATUM_USE_KMS=true or NODE_ENV=production.
ADMIN_API_KEYS=
# Optional CIDR list the admin key may be used from (ops egress IPs).
# Empty = unrestricted. The admin key mints spend-capable tenant keys —
# pinning it to ops IPs shrinks the leak blast radius to zero off-network.
ADMIN_ALLOWED_IPS=
# Number of trusted proxy hops (0 = direct connection, req.ip = socket peer).
# Set 1 behind nginx/ALB. MUST equal the real hop count — too high lets
# callers spoof X-Forwarded-For past per-client IP allowlists.
TRUST_PROXY_HOPS=0

# --- Deposit detection strategy ---
# polling = credit-minimal (free plan friendly): only burns credits while an
#           address awaits payment. webhook = real-time, needs public ingress
#           URL + paid plan (subscriptions cost 50 credits/day each + 50/event).
DEPOSIT_DETECTION=polling
DEPOSIT_POLL_INTERVAL_MS=120000
DEPOSIT_ADDRESS_TTL_MINUTES=60

# --- Deposit confirmation policy (per-chain required confirmations) ---
CONFIRMATIONS_BTC=2
CONFIRMATIONS_LTC=4
CONFIRMATIONS_ETH=12
CONFIRMATIONS_POLYGON=64
CONFIRMATIONS_SOL=32
CONFIRMATIONS_TRON=20

# --- Inbound webhook ingress ---
# Public URL Tatum calls for deposit events (this service's /api/v1/webhooks/tatum)
WEBHOOK_INGRESS_URL=https://your-service-domain.example.com/api/v1/webhooks/tatum
# When set, inbound Tatum webhooks must carry a valid x-payload-hash
# (HMAC-SHA512, Base64) — unsigned events get 401. The service self-enrolls
# the API key via PUT /v3/subscription/enableWebHookHmac at boot.
# REQUIRED before enabling DEPOSIT_DETECTION=webhook.
TATUM_WEBHOOK_HMAC_SECRET=
# Fixed-window rate limit on /webhooks (unauthenticated surface). Default 120.
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# --- Withdrawal policy (JSON maps of asset -> decimal string) ---
# Hard cap per transaction. {"BTC":"0.5","ETH":"5"}
WITHDRAWAL_LIMITS=
# Amount >= threshold parks the send as requires_approval until an admin
# approves via POST /api/v1/admin/withdrawals/{id}/approve. {"ETH":"0.5"}
WITHDRAWAL_APPROVAL_ABOVE=

# --- Reconciliation ---
# Hourly ledger-vs-on-chain comparison per asset; divergence posts a
# reconciliation.divergence outbound event. Report-only — never mutates.
RECONCILE_ENABLED=true
# On-chain native balance floor per treasury (JSON, keyed by chain).
# Below floor → treasury.gas_low alert event. Gas spend is not a ledger
# event, so only the chain knows the real balance.
# Defaults: BTC 0.0002, LTC 0.005, ETH 0.01, POLYGON 0.5, SOL 0.05, TRON 100
# TREASURY_GAS_FLOOR={"ETH":0.05,"POLYGON":2}

# --- Sweeps (deposit address -> treasury consolidation) ---
# Auto-sweep runs every 15 min when KMS is on. Disable with:
# SWEEP_AUTO_ENABLED=false
# Native gas amount sent to an address before an EVM token sweep.
# SWEEP_GAS_TOP_UP=0.005
# Per-asset floor below which a sweep isn't worth its fee (JSON map,
# keyed by asset code). Absent entries sweep any confirmed balance.
# SWEEP_MIN_BALANCE={"BTC":"0.0005","TRX":"10","ETH":"0.005"}
# Max sweeps per 15-min cycle (bounds KMS/provider load).
# SWEEP_MAX_PER_CYCLE=20

# --- Outbound webhook to the main Bitlily app ---
MAIN_APP_WEBHOOK_URL=
# HMAC secret used to sign outbound webhook payloads (X-Webhook-Signature header)
WEBHOOK_SIGNING_SECRET=change-me

# --- Wallet secrets (TESTNET ONLY). Production: use Tatum KMS / Vault, never env vars ---
# MASTER_MNEMONIC_BTC=
# MASTER_MNEMONIC_LTC=
# MASTER_MNEMONIC_ETH=
# MASTER_MNEMONIC_POLYGON=
# MASTER_MNEMONIC_SOL=
# MASTER_MNEMONIC_TRON=
