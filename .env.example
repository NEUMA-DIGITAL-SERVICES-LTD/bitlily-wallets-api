# --- Service ---
PORT=3100
NODE_ENV=development

# Comma-separated API keys accepted from the main application (X-API-Key
# header). These resolve to the 'default' tenant — fine while one app uses
# the service; add API_CLIENTS when a second app integrates.
# GENERATE a real one: python -c "import secrets;print('ak_'+secrets.token_hex(24))"
# — a committed default key is a live credential, as this repo once learned.
SERVICE_API_KEYS=

# Multi-tenant API clients (JSON). Each app gets its OWN key and webhook
# endpoint: a wallet created under slug 'acme' is invisible to every other
# key, and acme's deposit events sign with acme's webhookSecret and POST to
# acme's webhookUrl — never to another app's server.
# Onboarding a new app = add an entry here + restart. Ops action by design:
# a new tenant is a custody trust decision, not a self-serve signup.
# Optional per-entry fields:
#   "allowedIps":["203.0.113.0/24"] — restrict the key to those CIDRs
#   "enforceBalance":false          — the client's backend owns balance
#     checks (fiat-funded crypto withdrawals where no on-chain deposit
#     precedes the send). Debits still post; negative wallet balances are
#     the app's liability toward custody. Default true — the service
#     gates withdrawals on ledger balance.
# API_CLIENTS=[{"slug":"acme","name":"Acme Pay","apiKey":"<openssl rand -hex 24>","webhookUrl":"https://api.acme.example/webhooks/crypto","webhookSecret":"<openssl rand -hex 32>"}]
API_CLIENTS=

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitlily_crypto
# Password for the bundled compose Postgres — docker-compose reads this for
# BOTH the db service and the api's DATABASE_URL (compose ignores the
# DATABASE_URL above in container mode; that line is for local dev only).
# REQUIRED — compose refuses to start without it (no silent default).
# Set BEFORE the first `up`: Postgres applies it only on fresh-volume init.
POSTGRES_PASSWORD=

# --- Tatum ---
TATUM_API_KEY=
TATUM_BASE_URL=https://api.tatum.io
# testnet | mainnet — controls which Tatum endpoints/networks are used
TATUM_NETWORK=testnet
# If true, withdrawals are signed via a self-hosted Tatum KMS daemon (production required).
# KMS is a CLI daemon, not a REST service — enrollment is operator-run
# `tatum-kms generatemanagedwallet {chain}` on the KMS host, then registered
# here via POST /api/v1/admin/custody. See docs/KMS_SETUP.md.
# With TATUM_USE_KMS=false AND TATUM_NETWORK=mainnet the service refuses to boot.
TATUM_USE_KMS=false
# Shared secret embedded in the KMS daemon's --externalUrl path:
#   --externalUrl={base}/api/v1/kms/verify/{KMS_VERIFY_TOKEN}
# KMS concatenates {externalUrl}/{txId} — the token MUST be a path segment.
KMS_VERIFY_TOKEN=
# Daemon-side (consumed by the `kms` compose service, not the API):
# unlocks the local wallet store the daemon signs with.
TATUM_KMS_PASSWORD=
# Host path the daemon's wallet store directory is bind-mounted from —
# the custody keys live here, NOT in the container. Back it up; losing it
# with no other backup means losing custody.
#
# The path is machine-local: each host generates its OWN .tatumrc via the
# bootstrap ceremony (`docker compose run --rm kms generatemanagedwallet ...`
# — see docs/KMS_SETUP.md). Do NOT copy someone else's .env absolute path;
# Docker will try to mkdir it and fail (e.g. "mkdir C:\Users\<other-user>").
# The file must exist or be creatable at this path before `compose up` —
# generatemanagedwallet creates it on first run.
# Recommended: a project-relative path like ./kms/.tatumrc (gitignored).
KMS_WALLET_FILE=./kms/.tatumrc

# Solana JSON-RPC for shared-address deposit scanning + tx detail.
# Tatum has NO SOL address-history surface — SOL detection is canonical-RPC.
# The public cluster endpoints below are devnet-grade; production should
# point at a dedicated RPC (Helius/QuickNode/self-hosted) for rate limits
# and reliability. Default follows TATUM_NETWORK (devnet or mainnet-beta).
# SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Address-history indexers (txid attribution for the poller) ---
# The delta poller attributes real txids via these sources; when a source
# is unreachable/empty the delta stays pending+unattributed — it never
# falls back to crediting a synthetic txid (ledger-enforced invariant).
# TRONGRID_URL  : TronGrid for native TRX + TRC20 history (Tatum has no
#                 TRON address enumeration). Shasta on testnet.
# HISTORY_*_URL : any etherscan-compat explorer (Blockscout legacy /api,
#                 polygonscan, etherscan, routescan). *_API_KEY optional —
#                 Amoy has NO usable keyless indexer, set a polygonscan key.
# TRONGRID_URL=https://api.shasta.trongrid.io
# HISTORY_ETH_URL=https://eth-sepolia.blockscout.com/api
# HISTORY_ETH_API_KEY=
# HISTORY_POLYGON_URL=https://api-amoy.polygonscan.com/api
# HISTORY_POLYGON_API_KEY=
# BscScan has NO keyless tier — a key is required or BSC history is
# unavailable (deltas stay pending, never fabricated). Free key at
# bscscan.com/myapikey. Testnet explorer is api-testnet.bscscan.com.
# HISTORY_BNB_URL=https://api-testnet.bscscan.com/api
# HISTORY_BNB_API_KEY=

# Enabled asset codes (comma-separated). UNSET = every asset registered
# in src/config/assets.ts. Pin this list for controlled rollout — an
# enabled asset whose chain has no enrolled custody account fails wallet
# provisioning outright, so only enable BSC/DOGE after the KMS ceremony
# (generatemanagedwallet → POST /api/v1/admin/custody) has run.
# ENABLED_ASSETS=BTC,LTC,ETH,SOL,TRX,POL,BNB,DOGE,USDT_TRON,USDT_ETH,USDT_MATIC,USDC_ETH,USDC_MATIC,USDC_SOL,USDT_BEP20

# Comma-separated admin keys (X-Admin-Key header) for custody enrollment and
# withdrawal approval. REQUIRED in production — admin endpoints refuse all
# callers when unset and TATUM_USE_KMS=true or NODE_ENV=production.
ADMIN_API_KEYS=
# PREFERRED over ADMIN_API_KEYS: comma-separated hex SHA-256 digests of the
# admin keys. Callers send the DIGEST as X-Admin-Key (client-side hashing)
# — so the digest IS the credential; protect it accordingly, and rely on
# ADMIN_ALLOWED_IPS + rotation to bound a leak.
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_KEY').digest('hex'))"
ADMIN_API_KEY_HASHES=
# Optional CIDR list the admin key may be used from (ops egress IPs).
# Bare IPs and CIDRs both work — "203.0.113.10" is stored as "…/32",
# "203.0.113.0/24" passes through. Unparseable entries abort boot.
# Empty = unrestricted. The admin key mints spend-capable tenant keys —
# pinning it to ops IPs shrinks the leak blast radius to zero off-network.
ADMIN_ALLOWED_IPS=
# Number of trusted proxy hops (0 = direct connection, req.ip = socket peer).
# Set 1 behind nginx/ALB. MUST equal the real hop count — too high lets
# callers spoof X-Forwarded-For past per-client IP allowlists.
TRUST_PROXY_HOPS=0

# --- Deposit detection strategy ---
# polling = credit-minimal (free plan friendly): only burns credits while an
#           address awaits payment. webhook = real-time, needs public ingress
#           URL + paid plan (subscriptions cost 50 credits/day each + 50/event).
DEPOSIT_DETECTION=polling
DEPOSIT_POLL_INTERVAL_MS=120000
# Chains that get Tatum ADDRESS_EVENT subscriptions even under polling —
# for chains whose address-history indexer is unusable (BNB: BscScan is
# paywalled). The webhook supplies the deposit txid the poller can't
# discover; verification still re-fetches the tx, so spoofed events
# can't credit. Requires WEBHOOK_INGRESS_URL + TATUM_WEBHOOK_HMAC_SECRET.
# One subscription per address, shared by all its same-chain watches.
DEPOSIT_SUBSCRIBE_CHAINS=BNB

# --- SOL deposit-address model ---
# SOL is ed25519 (no xpub derivation) — unique per-user addresses must be
# pre-derived on the KMS host and pooled.
#   true  = each wallet gets its own permanent SOL address (no memo needed)
#   false = shared custody address + per-wallet deposit memo (default)
# Requires the pool seeded first (one KMS signatureId per address — SOL
# has no index derivation): API_KEY=... ADMIN_KEY=... \
#   node scripts/sol-pool-seed.js --count 500
# Pool exhaustion fails wallet provisioning 503 — it never silently falls
# back to shared+memo (that would break the per-user-address contract).
# Warn threshold for remaining free pooled addresses.
SOL_POOL_LOW_WATERMARK=20

# --- Deposit confirmation policy (per-chain required confirmations) ---
CONFIRMATIONS_BTC=2
CONFIRMATIONS_LTC=4
CONFIRMATIONS_ETH=12
CONFIRMATIONS_POLYGON=64
CONFIRMATIONS_SOL=32
CONFIRMATIONS_TRON=20
# BSC ~3s blocks (15 ≈ 45s); DOGE ~1min blocks (6 ≈ 6min).
CONFIRMATIONS_BNB=15
CONFIRMATIONS_DOGE=6

# --- Inbound webhook ingress ---
# Public URL Tatum calls for deposit events (this service's /api/v1/webhooks/tatum)
WEBHOOK_INGRESS_URL=https://your-service-domain.example.com/api/v1/webhooks/tatum
# When set, inbound Tatum webhooks must carry a valid x-payload-hash
# (HMAC-SHA512, Base64) — unsigned events get 401. The service self-enrolls
# the API key via PUT /v3/subscription/enableWebHookHmac at boot.
# REQUIRED before enabling DEPOSIT_DETECTION=webhook.
TATUM_WEBHOOK_HMAC_SECRET=
# Fixed-window rate limit on /webhooks (unauthenticated surface). Default 120.
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# --- Withdrawal policy (JSON maps of asset -> decimal string) ---
# Hard cap per transaction. {"BTC":"0.5","ETH":"5"}
# "*" is a wildcard covering every asset — {"*":"0"} is the incident
# kill-switch that rejects all withdrawals before any debit.
WITHDRAWAL_LIMITS=
# Amount >= threshold parks the send as requires_approval until an admin
# approves via POST /api/v1/admin/withdrawals/{id}/approve. {"ETH":"0.5"}
# Supports the same "*" wildcard; keep thresholds below the hard caps.
WITHDRAWAL_APPROVAL_ABOVE=

# --- Reconciliation ---
# Hourly ledger-vs-on-chain comparison per asset; divergence posts a
# reconciliation.divergence outbound event. Report-only — never mutates.
RECONCILE_ENABLED=true
# On-chain native balance floor per treasury (JSON, keyed by chain).
# Below floor → treasury.gas_low alert event. Gas spend is not a ledger
# event, so only the chain knows the real balance.
# Defaults: BTC 0.0002, LTC 0.005, ETH 0.01, POLYGON 0.5, SOL 0.05, TRON 100, BSC 0.005, DOGE 50
# TREASURY_GAS_FLOOR={"ETH":0.05,"POLYGON":2}

# --- Sweeps (deposit address -> treasury consolidation) ---
# Auto-sweep runs every 15 min when KMS is on. Disable with:
# SWEEP_AUTO_ENABLED=false
# Native gas amount sent to an address before an EVM token sweep.
# SWEEP_GAS_TOP_UP=0.005
# Per-asset floor below which a sweep isn't worth its fee (JSON map,
# keyed by asset code). Absent entries sweep any confirmed balance.
# SWEEP_MIN_BALANCE={"BTC":"0.0005","TRX":"10","ETH":"0.005"}
# Max sweeps per 15-min cycle (bounds KMS/provider load).
# SWEEP_MAX_PER_CYCLE=20

# --- Outbound webhook to the main Bitlily app ---
MAIN_APP_WEBHOOK_URL=
# HMAC secret used to sign outbound webhook payloads (X-Webhook-Signature header)
WEBHOOK_SIGNING_SECRET=change-me

# --- USD pricing on webhook payloads ---
# Deposit/withdrawal events carry usdPrice, usdValue, priceSource, pricedAt
# (stamped once at event time; stablecoins peg 1.00 with source 'peg').
# CoinGecko free tier works keyless; a demo/pro key raises rate limits.
# PRICING_ENABLED=false emits the fields as null instead.
# COINGECKO_API_KEY=
# COINGECKO_API_URL=https://api.coingecko.com/api/v3

# --- Wallet secrets (TESTNET ONLY). Production: use Tatum KMS / Vault, never env vars ---
# MASTER_MNEMONIC_BTC=
# MASTER_MNEMONIC_LTC=
# MASTER_MNEMONIC_ETH=
# MASTER_MNEMONIC_POLYGON=
# MASTER_MNEMONIC_SOL=
# MASTER_MNEMONIC_TRON=

# ============================================================================
# PRODUCTION / MAINNET — read docs/MAINNET_CUTOVER.md before touching these.
# Every value below overrides or hard-requires its testnet counterpart.
# ============================================================================

# TATUM_NETWORK=mainnet
# TATUM_USE_KMS=true            # REQUIRED — boot refuses mainnet without KMS
# NODE_ENV=production

# --- Secrets: never plaintext on prod ---
# TATUM_KMS_PASSWORD goes in the client-owned vault (AWS Secrets Manager /
# Azure Key Vault / VGS via the TATUM_KMS_* vault envs tatum-kms supports),
# or an env-only injection on the KMS host — never committed, never shared.
# ADMIN_API_KEY_HASHES only (sha256 hex of each admin key) — no raw keys.
# SERVICE_API_KEYS: client-generated production tenant keys.
# TATUM_API_KEY: the CLIENT's key, from their Tatum account.

# --- Stable ingress (replaces any tunnel) ---
# WEBHOOK_INGRESS_URL=https://crypto-api.<client-domain>/api/v1/webhooks/tatum
# TATUM_WEBHOOK_HMAC_SECRET=<rotated-for-prod>

# --- Custody ceremony output (per chain, on the prod host) ---
# generatemanagedwallet: BTC LTC ETH MATIC TRON BSC DOGE   (BSC = BNB Chain)
# generatemanagedprivatekeybatch SOL <n>  OR scripts/sol-pool-seed.js
# DOGE mainnet: enroll the `xpub` form — the `tpub` fix was TESTNET-only.
# Enroll each via POST /api/v1/admin/custody (admin key, IP-gated).

# --- Risk limits: client's numbers, mandatory before real funds ---
# WITHDRAWAL_LIMITS={"BTC":"…","ETH":"…","BNB":"…","USDT_BEP20":"…","*":"…"}
# WITHDRAWAL_APPROVAL_ABOVE={"BTC":"…","*":"…"}  (var name — not _THRESHOLD)
# CONFIRMATIONS_BNB=15 CONFIRMATIONS_DOGE=6  (raise per chain policy)

# --- Mainnet history/explorer keys (auto-selected by TATUM_NETWORK) ---
# HISTORY_ETH_URL/HISTORY_POLYGON_URL/HISTORY_BNB_URL already switch to
# mainnet endpoints; each still needs its *_API_KEY for attribution.
# Or rely on DEPOSIT_SUBSCRIBE_CHAINS + webhook subscriptions (Pro plan).
# DEPOSIT_SUBSCRIBE_CHAINS=BNB   # extend per chain as needed

# --- What stays OFF prod ---
# TESTNET_PK_* / TESTNET_FROM_* — dev-mode signing keys, leave empty.
# Ngrok/webhook.site URLs anywhere — subscriptions bind to the stable domain.
